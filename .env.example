# Copy to .env (gitignored) at the repo root and fill in your own values.
# These override the placeholders in infrastructure/cdk.json; an explicit
# `cdk deploy -c key=value` flag still wins over both.

MUBWEM_ALERT_EMAIL=you@yourdomain.com
# From address on the alert email. Defaults to MUBWEM_ALERT_EMAIL, which is
# what you want while SES is in its sandbox - one verified address covers both
# ends. Set it only once you have a verified sending domain.
# MUBWEM_SENDER_EMAIL=alerts@yourdomain.com
MUBWEM_FAILURE_THRESHOLD=3
MUBWEM_CHECK_TIMEOUT_SEC=8
MUBWEM_CHECKS_TTL_DAYS=30
MUBWEM_SCHEDULE_EXPRESSION=rate(1 minute)
MUBWEM_SCHEDULE_TIMEZONE=Australia/Sydney
MUBWEM_REGION=ap-southeast-2
# Optional: pin the target account instead of using the current CLI profile.
# MUBWEM_ACCOUNT=123456789012
