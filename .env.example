# Copy to .env (gitignored) at the repo root and fill in your own values.
# These override the placeholders in infrastructure/cdk.json; an explicit
# `cdk deploy -c key=value` flag still wins over both.

MUBWEM_ALERT_EMAIL=you@yourdomain.com
# From address on the alert email. Defaults to MUBWEM_ALERT_EMAIL, which is
# what you want while SES is in its sandbox - one verified address covers both
# ends. Set it only once you have a verified sending domain.
# MUBWEM_SENDER_EMAIL=alerts@yourdomain.com
# Verify this whole domain in SES with Easy DKIM and send from it. Needed when
# the sender's domain has a DMARC policy of reject/quarantine, otherwise the
# alerts bounce with 5.7.509. MUBWEM_SENDER_EMAIL must be an address at it.
# Publish the three SenderDkimRecord outputs in the domain's DNS after deploy.
# MUBWEM_SENDER_DOMAIN=alerts.yourdomain.com
# If that domain is a Route 53 public hosted zone, give its ID and CDK writes
# the DKIM and MAIL FROM (bounce.<domain>) records itself - no outputs to copy.
# MUBWEM_SENDER_HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ
# Where SES bounce/complaint notifications go. Defaults to
# MUBWEM_ALERT_EMAIL. These arrive as raw SES event JSON, so point them
# somewhere a human will actually read if that is not the same inbox.
# MUBWEM_BOUNCE_ALERT_EMAIL=alerts@yourdomain.com
# The primary Owner. Set it on the FIRST deploy and cdk creates this user in
# Owners and Cognito emails them a temporary password - no CLI bootstrap step.
# Leave it unset on a deployment whose first Owner already exists: creating a
# user that is already in the pool fails the deploy.
# MUBWEM_OWNER_EMAIL=you@yourdomain.com
MUBWEM_FAILURE_THRESHOLD=3
MUBWEM_CHECK_TIMEOUT_SEC=8
MUBWEM_CHECKS_TTL_DAYS=30
MUBWEM_NOTIFICATIONS_TTL_DAYS=90
MUBWEM_SCHEDULE_EXPRESSION=rate(1 minute)
MUBWEM_SCHEDULE_TIMEZONE=Australia/Sydney
MUBWEM_REGION=ap-southeast-2
# Optional: pin the target account instead of using the current CLI profile.
# MUBWEM_ACCOUNT=123456789012
