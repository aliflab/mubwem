{
  "app": "python app.py",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "requirements*.txt",
      "**/__pycache__",
      "**/*.pyc"
    ]
  },
  "context": {
    "_comment": "MuBWeM configuration. Override any of these at deploy time with -c key=value, or via MUBWEM_-prefixed env vars in a gitignored .env at the repo root. Never commit a real email address here.",

    "alertEmail": "CHANGE_ME@example.com",
    "senderEmail": "CHANGE_ME@example.com",
    "bounceAlertEmail": "CHANGE_ME@example.com",
    "failureThreshold": 3,
    "checkTimeoutSec": 8,
    "checksTtlDays": 30,
    "scheduleExpression": "rate(1 minute)",
    "scheduleTimezone": "Australia/Sydney",
    "region": "ap-southeast-2",

    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "@aws-cdk-containers/ecs-service-extensions:enableDefaultLogDriver": true,
    "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:stackRelativeExports": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-sns-subscriptions:restrictSqsDescryption": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
    "@aws-cdk/core:newStyleStackSynthesis": true,
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/aws-cloudfront:useOriginAccessControlForS3Origins": true
  }
}
